# Environment Variables for WeilChain Nexus

# ============================================
# WeilChain Configuration (Production)
# ============================================

# Sentinel endpoint for WeilChain network
NEXT_PUBLIC_SENTINEL_ENDPOINT=https://sentinel.unweil.me

# WeilChain Applet Addresses (Update after deployment)
NEXT_PUBLIC_WEIL_REGISTRY_ADDRESS=your_registry_address_here
NEXT_PUBLIC_WEIL_MARKETPLACE_ADDRESS=your_marketplace_address_here
NEXT_PUBLIC_WEIL_TOKEN_ADDRESS=your_nexus_token_address_here
NEXT_PUBLIC_WEIL_LOGGER_ADDRESS=

# ============================================
# Optional Services
# ============================================

# Hugging Face API (for AI Summarizer)
NEXT_PUBLIC_HF_TOKEN=your_huggingface_token_here
